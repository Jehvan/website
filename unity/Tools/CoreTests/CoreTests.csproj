<Project Sdk="Microsoft.NET.Sdk">
  <!-- Headless tests for the game core: data integrity, save round-trip, and a bot that clears every stage using
       click-to-target controls only. Run: dotnet run -c Release (from this folder). -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>9.0</LangVersion>
    <Nullable>disable</Nullable>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../../Assets/HighkeepRoad/Core/**/*.cs" />
    <Compile Include="*.cs" />
  </ItemGroup>
</Project>
